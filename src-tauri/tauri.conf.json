{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Central DevOps Kit",
  "version": "0.0.9",
  "identifier": "os.central.devops.kit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Central DevOps Kit",
        "width": 1000,
        "height": 600,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi",
      "deb",
      "appimage",
      "rpm"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {},
      "appimage": {},
      "rpm": {}
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5NjE3MzczOTJDNzBERDMKUldUVERjZVNjM05oYVNPR09uYjQ4S0tueHJZemZteWxSOXJhM01pcUYyaXQrVENVSzhBcHVlOVIK",
      "endpoints": [
        "https://ghfast.top/https://github.com/9527-tb/central-devops-kit/releases/latest/download/latest.json",
        "https://cdn.jsdelivr.net/gh/9527-tb/central-devops-kit@master/updater/latest.json",
        "https://github.com/9527-tb/central-devops-kit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
